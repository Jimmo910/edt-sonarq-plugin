<unit id="com._1c.g5.v8.dt.thirdparty.feature.group" version="0.0.0"/>
<!-- JFace 3.38 requires the SWT SVG image provider (Require-Capability eclipse.swt image.format=svg);
     in slicer mode it is not pulled transitively, so the provider and its Batik backend are listed here. -->
<unit id="org.eclipse.swt.svg" version="0.0.0"/>
<unit id="org.eclipse.orbit.maven.org.apache.batik.feature.group" version="0.0.0"/>
</location>

