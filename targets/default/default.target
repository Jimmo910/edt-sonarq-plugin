<!-- EDT (also supplies the Eclipse 4.38 platform, JUnit 4.13.2, gson, jgit, SCR and SPI-Fly this
     plugin needs, so no separate Eclipse/Orbit locations are required — verified against the
     2026.2 p2 metadata on 2026-08-06) -->
<location followRepositoryReferences="false" includeAllPlatforms="true" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<repository id="dt_repository" location="https://edt.1c.ru/downloads/releases/ruby/2026.2/"/>
